{
  "id": "localjam-pwa",
  "name": "LocalJam - Local Audio Player",
  "short_name": "LocalJam",
  "description": "High-fidelity, privacy-first, local-first Progressive Web App music and audio player.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0b0f17",
  "theme_color": "#0b0f17",
  "orientation": "any",
  "categories": ["music", "audio", "entertainment", "utilities"],
  "icons": [
    {
      "src": "./public/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./public/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./favicon.svg",
      "sizes": "64x64",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
